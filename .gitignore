# ==========================================
# DevLens .gitignore
# Frontend: React 19 + Vite
# Backend:  Python 3.13 + FastAPI
# ==========================================

# ------------------------------------------
# SECRETS & ENVIRONMENT (never commit these)
# ------------------------------------------
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ------------------------------------------
# PYTHON
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
*.egg-info/
.eggs/
dist/
build/
wheels/
sdist/
pip-wheel-metadata/
share/python-wheels/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
var/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# ------------------------------------------
# NODE / FRONTEND
# ------------------------------------------
node_modules/
frontend/node_modules/

# Vite build output
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/

# Cache
.vite/
.eslintcache
.nyc_output/

# ------------------------------------------
# LOCAL DATABASES (use Supabase in prod)
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
devlens.db
backend/*.db

# ------------------------------------------
# LOGS
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# OS / EDITOR JUNK
# ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# JetBrains IDEs
.idea/

# VS Code (keep shared settings, ignore personal)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Windows Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# AI TOOLING METADATA (not needed in repo)
# ------------------------------------------
.agents/
.claude/
.gemini/

# ------------------------------------------
# LOCAL DOCUMENTATION
# ------------------------------------------
docs/

