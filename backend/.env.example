# DevLens Backend Environment Configuration Template

# Local SQLite (Default)
DATABASE_URL=sqlite+aiosqlite:///./devlens.db

# Supabase PostgreSQL (Production)
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT Secret
JWT_SECRET=devlens_jwt_secret_key_2026_super_secure

# Gemini API Key
GEMINI_API_KEY=

# Server Config
HOST=127.0.0.1
PORT=8000
